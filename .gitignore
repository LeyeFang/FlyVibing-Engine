# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
/wheels/
*.egg-info
Application/Editor/Config
.editor_cache.json
.txt

# Virtual environments
.venv
.venv-*
.vscode
.github

# Runtime packaging / game export (P2+)
# 运行时镜像与 wheelhouse 不进 git（拉取轻量; 开发者按 README 用 uv/PyPI 重建）——
# 例外仅 3 类: requirements 两份 + CHECKSUMS + 自建 imgui cp314t 引导轮（PyPI 无发行）
Resource/runtime/
Resource/wheels/*
!Resource/wheels/requirements.export.txt
!Resource/wheels/requirements.runtime.txt
!Resource/wheels/CHECKSUMS.sha256
!Resource/wheels/imgui_bundle-1.92.5-cp314-cp314t-win_amd64.whl

# Test/: 只跟踪测试源码与小型 fixture；运行产物/缓存保持忽略（2026-10-21 局部放开）
Test/*
!Test/Application/
!Test/Helpers/
!Test/Resources/
!Test/Device/
!Test/TestProject/
!Test/_path_setup.py
!Test/_test_harness.py
!Test/_test_scene.py
!Test/README.md

# Test runtime artifacts (never commit)
Test/_runs/
Test/_archive/
Test/_gtec_archive_20261016/
Test/**/__pycache__/
Test/**/*.py[co]
Test/Application/Editor/imgui.ini
Test/Application/Editor/graph.json
Test/Application/Functions/_siggen_e2e_out/
Test/TestProject/**/dist/
Test/TestProject/**/output/
Test/TestProject/**/runtime/
Test/TestProject/**/seed/
Test/TestProject/**/*.txt
Test/TestProject/**/*.log

# Editor Live MCP 临时目录（E2E/报告产物；运行时生成）
FlyVibing-User-And-Developer-Utils/packages/editor-mcp/tmp/

# Installer 临时探测目录（pypi probe 等）
Utils/Dev/Installer/tmp/
# imgui 布局持久化产物（引擎侧已禁用 ini; 扩展自测的裸上下文可能写出 — 勿入库）
imgui.ini

# 使用侧工具链的开发链接（junction -> FlyVibing-User-And-Developer-Utils）—— 不得提交
Utils/ExtDev/

# 内置扩展跟踪策略（白名单式, 2026-10-16）: Application/Functions 默认整体忽略 —
# 仅官方扩展显式放行; Gtec（社区插件本地夹具）不在白名单 → 天然忽略。
Application/Functions/*
