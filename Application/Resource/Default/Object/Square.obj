# 一个二维小方块（正方形平面），位于 Z=0 平面
# 顶点坐标 (x, y, z)
v -1.0 -1.0  0.0    # 左下
v  1.0 -1.0  0.0    # 右下
v  1.0  1.0  0.0    # 右上
v -1.0  1.0  0.0    # 左上

# 纹理坐标 (u, v)
vt 0.0 0.0    # 左下
vt 1.0 0.0    # 右下
vt 1.0 1.0    # 右上
vt 0.0 1.0    # 左上

# 法线 (nx, ny, nz) – 平面朝 +Z 方向
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0

# 面定义 (顶点索引/纹理索引/法线索引)
# 第一个三角形（左下 → 右下 → 右上）
f 1/1/1 2/2/2 3/3/3
# 第二个三角形（左下 → 右上 → 左上）
f 1/1/1 3/3/3 4/4/4